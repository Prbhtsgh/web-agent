# Copy this file to .env and pick ONE model option.

# Option A — free, local on your Mac (Ollama). Run: ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5:7b

# Option B — AMD GPU notebook (vLLM). Start the server with scripts/start_vllm.sh first.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Option C — any hosted OpenAI-compatible API (Fireworks, OpenAI, OpenRouter, Groq...)
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=<model id from the provider's model list>

# Agent behaviour
MAX_STEPS=8
MAX_PAGE_CHARS=6000
MAX_LINKS=40
SAME_DOMAIN_ONLY=true
PAGE_TIMEOUT_MS=20000
HEADLESS=true
